// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // For local: set DATABASE_URL in .env.local
  // For Vercel: set DATABASE_URL = POSTGRES_URL_NON_POOLING in environment variables
  url      = env("DATABASE_URL")
}

// ============================================
// HOW TO RUN MIGRATIONS
// ============================================
//
// First time setup (initial migration):
//   1. Run: npm run prisma:migrate
//   2. This will create the database file at: prisma/dev.db
//   3. All migrations will be applied automatically
//
// To create a new migration after schema changes:
//   1. Make changes to this schema file
//   2. Run: npm run prisma:migrate -- --name your_migration_name
//   3. Or: npm run prisma:migrate (Prisma will prompt for a name)
//
// To generate Prisma Client (usually done automatically):
//   Run: npm run prisma:generate
//
// To open Prisma Studio (database GUI):
//   Run: npm run prisma:studio
//
// ============================================

// Note: SQLite doesn't support enums, so we use String types
// Valid values are defined in TypeScript constants (lib/types.ts)
// Role: "CLIENT" | "TRAINER" | "ADMIN"
// SessionStatus: "PLANNED" | "CANCELLED" | "FINISHED"
// BookingStatus: "ACTIVE" | "CANCELLED_BY_CLIENT" | "CANCELLED_BY_TRAINER"

// Models
model User {
  id         String   @id @default(cuid())
  telegramId String   @unique
  name       String
  role       String   // Role: "CLIENT" | "TRAINER" | "ADMIN"
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  trainerProfile Trainer?
  bookings       Booking[]
}

model Trainer {
  id          String   @id @default(cuid())
  userId      String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions Session[]
}

model WorkoutType {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  sessions Session[]
}

model Session {
  id            String   @id @default(cuid())
  trainerId     String
  workoutTypeId String
  startAt       DateTime
  endAt         DateTime
  maxClients    Int      @default(10)
  status        String   @default("PLANNED") // SessionStatus: "PLANNED" | "CANCELLED" | "FINISHED"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  trainer     Trainer    @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  workoutType WorkoutType @relation(fields: [workoutTypeId], references: [id], onDelete: Cascade)
  bookings    Booking[]
}

model Booking {
  id          String    @id @default(cuid())
  sessionId   String
  userId      String
  status      String    @default("ACTIVE") // BookingStatus: "ACTIVE" | "CANCELLED_BY_CLIENT" | "CANCELLED_BY_TRAINER"
  createdAt   DateTime  @default(now())
  cancelledAt DateTime?
  updatedAt   DateTime  @updatedAt

  // Relations
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

